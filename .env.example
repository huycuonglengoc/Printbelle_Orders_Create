PORT=3000
NODE_ENV=development

# Printbelle API
PRINTBELLE_API_BASE_URL=https://fulfillment.printbelle.com
PRINTBELLE_API_TOKEN=
# Default create endpoint used by the Printbelle API adapter. Override if your
# Printbelle account provides a different create-order path.
PRINTBELLE_CREATE_ORDER_PATH=/prod_api/api/orders/v2/create
PRINTBELLE_LIST_ORDERS_PATH=/prod_api/api/orders/v2/all
PRINTBELLE_API_TIMEOUT_MS=30000
PRINTBELLE_DRY_RUN=true

# Used by Printbelle to fetch uploaded artwork. On Railway this should be the
# public Railway domain or a stable object-storage URL prefix.
ARTWORK_BASE_URL=http://localhost:3000
UPLOAD_DIR=./var/uploads

# Cloudflare R2 artwork storage for Excel import files. R2_PUBLIC_BASE_URL
# must be an HTTPS public custom domain or r2.dev URL; do not use the S3 API
# endpoint because Printbelle must download artwork without authentication.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://artwork.example.com
R2_REQUIRED=true
# Optional override; the default is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Keep the provided import template at the project root, or override this path.
ORDER_IMPORT_TEMPLATE_PATH=./order_import_template.xlsx

# Config is managed from the web UI and saved on the server.
# On Railway, use a mounted Volume path for persistence across redeploys.
CATALOG_CONFIG_PATH=./data/catalog.json
